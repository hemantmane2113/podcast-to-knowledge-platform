# Copy this file to .env and fill in real values.
# Never commit .env — see PRODUCT_SPEC.md §53-54 and ARCHITECTURE.md §10.

# --- App -----------------------------------------------------------------

# development | staging | production
APP_ENV=development

# --- Database --------------------------------------------------------------

# PostgreSQL (with pgvector extension enabled) connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/podcast_to_knowledge

# --- Queue / cache -----------------------------------------------------------

# Redis, used for the background job queue and caching
REDIS_URL=redis://localhost:6379/0

# --- Transcript provider (Supadata) -----------------------------------------

# https://supadata.ai/ — used by SupadataTranscriptProvider to fetch
# YouTube metadata and transcripts. Never hard-code this key.
SUPADATA_API_KEY=

# --- LLM provider ------------------------------------------------------------

# API key for the LLMProvider implementation used for chunk analysis,
# article planning/generation, verification, revision, and Q&A.
LLM_API_KEY=

# Model identifier passed to the LLM provider.
LLM_MODEL=

# --- Embeddings ----------------------------------------------------------------

# Model identifier for the EmbeddingProvider implementation.
EMBEDDING_MODEL=

# Dimensionality of the embedding vectors stored in pgvector; must match
# EMBEDDING_MODEL's output dimension.
VECTOR_DIMENSION=1536

# --- Semantic chunking (PRODUCT_SPEC.md §21) ------------------------------------

CHUNK_TARGET_TOKENS=800
CHUNK_MIN_TOKENS=300
CHUNK_MAX_TOKENS=1200
CHUNK_OVERLAP_TOKENS=100

# --- Fidelity verification / revision loop (PRODUCT_SPEC.md §37) ---------------

# Maximum number of generate -> verify -> revise cycles before accepting
# the article as-is and flagging it for human review.
MAX_REVISION_ATTEMPTS=2

# --- Admin auth (PRODUCT_SPEC.md §66) -------------------------------------------

# Secret used to sign/validate admin session tokens. Generate a long random
# value; never reuse across environments.
ADMIN_AUTH_SECRET=

# --- Object storage (PRODUCT_SPEC.md §9, if not using local disk) --------------

# local | s3 (extend as additional StorageProvider implementations are added)
STORAGE_PROVIDER=local

# Only required when STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Frontend (Next.js) ---------------------------------------------------------

# Base URL the frontend uses to reach the FastAPI backend. This is the only
# API-related value that belongs in frontend config — no secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
