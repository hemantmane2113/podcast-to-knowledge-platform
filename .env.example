# Copy this file to .env and fill in real values.
# Never commit .env — see PRODUCT_SPEC.md §53-54 and ARCHITECTURE.md §10.

# --- App -----------------------------------------------------------------

# development | staging | production
APP_ENV=development

# --- Database --------------------------------------------------------------

# PostgreSQL (with pgvector extension enabled) connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/podcast_to_knowledge

# --- Queue / cache -----------------------------------------------------------

# Redis, used for the background job queue and caching
REDIS_URL=redis://localhost:6379/0

# --- Transcript provider (Supadata) -----------------------------------------

# https://supadata.ai/ — used by SupadataTranscriptProvider to fetch
# YouTube metadata and transcripts. Never hard-code this key.
SUPADATA_API_KEY=

# --- LLM provider (app/providers/llm/ -- topic analysis, article planning, -----
# --- section generation, validation; app/ai/graph.py) --------------------------

# groq | openai | opensource -- selects which LLMProvider implementation
# app/providers/llm/factory.py constructs. Only the selected provider's own
# API key is required outside development (see app/config/settings.py).
LLM_PROVIDER=groq

# Required regardless of which provider is selected -- one model for the
# whole pipeline in V1 (see ARCHITECTURE.md's model-selection notes).
LLM_MODEL=

# Required when LLM_PROVIDER=groq.
GROQ_API_KEY=

# Required when LLM_PROVIDER=openai, and also when OPENAI_FALLBACK_ENABLED
# is true below (used to construct the fallback provider).
OPENAI_API_KEY=

# Required when LLM_PROVIDER=opensource -- an OpenAI-compatible endpoint
# (vLLM, Ollama, TGI, ...), e.g. http://localhost:8080/v1
OPENSOURCE_BASE_URL=
# Optional -- most self-hosted servers don't enforce a real key.
OPENSOURCE_API_KEY=

# When true and LLM_PROVIDER isn't already "openai", a retryable primary
# failure (rate limit / 5xx / connection error) falls back to OpenAI once
# instead of failing the job -- see app/providers/llm/fallback_provider.py.
# Auth/config/malformed-request errors are never retried this way.
OPENAI_FALLBACK_ENABLED=true
OPENAI_FALLBACK_MODEL=gpt-5.4

# Off by default: an additional, whole-article editorial review (never a
# replacement for the deterministic checks in
# app/services/article_validation.py -- its coherence judgment stays
# advisory-only). Adds one extra paid call per article, and its findings
# can trigger a targeted revision round (see app/ai/nodes/validation.py).
ENABLE_LLM_VALIDATION=false

# Rough token budget for one topic-analysis call's chunk text -- long
# transcripts are batched under this and merged (app/ai/nodes/topic_analysis.py).
TOPIC_ANALYSIS_TOKEN_BUDGET=12000

# Soft ceiling on generated-article length as a fraction of the source
# transcript's word count (reported by article_validation.py, not a hard block).
ARTICLE_MAX_LENGTH_RATIO=0.4

# --- Embeddings ----------------------------------------------------------------

# Model identifier for the EmbeddingProvider implementation.
EMBEDDING_MODEL=

# Dimensionality of the embedding vectors stored in pgvector; must match
# EMBEDDING_MODEL's output dimension.
VECTOR_DIMENSION=1536

# --- Semantic chunking (PRODUCT_SPEC.md §21, ARCHITECTURE.md §6) ---------------

# Target chunk size the chunker tries to reach before looking for a good
# place to stop (sentence end / pause gap). Not a hard limit.
CHUNK_TARGET_TOKENS=800
# Below this, a boundary is skipped in favor of accumulating more segments
# (except the transcript's final trailing chunk, which may be smaller).
CHUNK_MIN_TOKENS=300
# Hard ceiling — always enforced, even if it means splitting a single long
# transcript segment's text.
CHUNK_MAX_TOKENS=1200
# Segment-granular overlap between adjacent chunks, in approximate tokens.
# Defaults to 0 (disabled) — nothing consumes it yet (no embeddings/RAG
# until Phase 3C); set above 0 once something does.
CHUNK_OVERLAP_TOKENS=0
# A gap at least this long between two consecutive transcript segments is
# treated as a candidate chunk boundary (one signal among several, not an
# absolute rule).
CHUNK_PAUSE_THRESHOLD_MS=1500

# --- Fidelity verification / revision loop (PRODUCT_SPEC.md §37) ---------------

# Maximum number of generate -> verify -> revise cycles before accepting
# the article as-is and flagging it for human review.
MAX_REVISION_ATTEMPTS=2

# --- Admin auth (PRODUCT_SPEC.md §66) -------------------------------------------

# Secret used to sign/validate admin session tokens. Generate a long random
# value; never reuse across environments.
ADMIN_AUTH_SECRET=

# --- Object storage (PRODUCT_SPEC.md §9, if not using local disk) --------------

# local | s3 (extend as additional StorageProvider implementations are added)
STORAGE_PROVIDER=local

# Only required when STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Frontend (Next.js) ---------------------------------------------------------

# Base URL the frontend uses to reach the FastAPI backend. This is the only
# API-related value that belongs in frontend config — no secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
